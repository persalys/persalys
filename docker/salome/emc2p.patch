+        command = args[0]
+        options = args[1:]
+
+        availableCommands = {
+            "start": "_sessionless",
+            "withsession": "_runAppli",
+            "context": "_setContext",
+            "shell": "_runSession",
+            "remote": "_runRemote",
+            "connect": "_runConsole",
+            "kill": "_kill",
+            "killall": "_killAll",
+            "test": "_runTests",
+            "info": "_showInfo",
+            "doc": "_showDoc",
+            "help": "_usage",
+            "coffee": "_makeCoffee",
+            "car": "_getCar",
+        }
+
+        if command not in availableCommands:
+            command = "start"
+            options = args
+
+        return availableCommands[command], options
