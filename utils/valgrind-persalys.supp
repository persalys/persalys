# Valgrind suppression file for Persalys.
#
# These suppressions silence known, non-actionable leaks that originate deep
# inside third-party libraries used by Persalys (OpenMPI, hwloc, libpciaccess,
# CPython, fontconfig, X11 ICE/SM session management, LLVM). They happen once
# during process startup (MPI_Init, Py_Initialize, Qt/X11 init) and are not
# caused by Persalys's own code, nor do they grow with usage.
#
# Usage:
#   valgrind --leak-check=full --show-leak-kinds=all \
#            --suppressions=utils/valgrind-persalys.supp \
#            build/main/persalys

{
   persalys-openmpi-orte-init
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   fun:malloc
   ...
   fun:orte_init
}

{
   persalys-openmpi-orte-init-calloc
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   fun:calloc
   ...
   fun:orte_init
}

{
   persalys-openmpi-orte-finalize
   Memcheck:Leak
   match-leak-kinds: definite,indirect,possible,reachable
   fun:malloc
   ...
   fun:orte_finalize
}

