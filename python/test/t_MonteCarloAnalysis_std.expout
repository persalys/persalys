#!/usr/bin/env python

import openturns as ot
import persalys

myStudy = persalys.Study('myStudy')
persalys.Study.Add(myStudy)
dist_X0 = ot.Normal(1, 1)
X0 = persalys.Input('X0', 0, dist_X0, '')
dist_X1 = ot.Normal(1, 1)
X1 = persalys.Input('X1', 0, dist_X1, '')
X2 = persalys.Input('X2', 2, '')
fake_Y0 = persalys.Output('fake_Y0', '')
fake_Y0.setIsSelected(False)
Y0 = persalys.Output('Y0', '')
Y1 = persalys.Output('Y1', '')
inputs = [X0, X1, X2]
outputs = [fake_Y0, Y0, Y1]
formulas = ['X0', 'sin(X0) + 8*X1', 'sin(X0) + 8*X1 + X2']
aModelPhys = persalys.SymbolicPhysicalModel('aModelPhys', inputs, outputs, formulas)
myStudy.add(aModelPhys)
dist_X2 = ot.Normal(0, 1)
X2 = persalys.Input('X2', 0, dist_X2, '')
Y2 = persalys.Output('Y2', '')
inputs = [X2]
outputs = [Y2]
formulas = ['X2*X2']
aModelPhys2 = persalys.SymbolicPhysicalModel('aModelPhys2', inputs, outputs, formulas)
myStudy.add(aModelPhys2)
myMonteCarlo = persalys.MonteCarloAnalysis('myMonteCarlo', aModelPhys)
interestVariables = ['Y0']
myMonteCarlo.setInterestVariables(interestVariables)
myMonteCarlo.setMaximumCalls(1000)
myMonteCarlo.setMaximumCoefficientOfVariation(-1)
myMonteCarlo.setMaximumElapsedTime(30)
myMonteCarlo.setBlockSize(1)
myMonteCarlo.setSeed(2)
myStudy.add(myMonteCarlo)
myMonteCarlo2 = persalys.MonteCarloAnalysis('myMonteCarlo2', aModelPhys)
interestVariables = ['Y0']
myMonteCarlo2.setInterestVariables(interestVariables)
myMonteCarlo2.setMaximumCoefficientOfVariation(0.02)
myMonteCarlo2.setMaximumElapsedTime(100000)
myMonteCarlo2.setBlockSize(100)
myMonteCarlo2.setSeed(0)
myStudy.add(myMonteCarlo2)
myMonteCarlo3 = persalys.MonteCarloAnalysis('myMonteCarlo3', aModelPhys)
interestVariables = ['Y1']
myMonteCarlo3.setInterestVariables(interestVariables)
myMonteCarlo3.setMaximumCalls(1000)
myMonteCarlo3.setMaximumCoefficientOfVariation(0.01)
myMonteCarlo3.setMaximumElapsedTime(60)
myMonteCarlo3.setBlockSize(1)
myMonteCarlo3.setSeed(0)
myStudy.add(myMonteCarlo3)
myMonteCarlo4 = persalys.MonteCarloAnalysis('myMonteCarlo4', aModelPhys2)
myMonteCarlo4.setMaximumCoefficientOfVariation(0.01)
myMonteCarlo4.setMaximumElapsedTime(60)
myMonteCarlo4.setBlockSize(1)
myMonteCarlo4.setSeed(0)
myStudy.add(myMonteCarlo4)

