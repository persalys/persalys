#!/usr/bin/env python

import openturns as ot
import persalys

myStudy = persalys.Study('myStudy')
persalys.Study.Add(myStudy)
dist_R = ot.LogNormal(20.4355, 0.0146659, 0)
R = persalys.Input('R', 700000000, dist_R, 'Parameter R')
dist_C = ot.Normal(2.75e+09, 2.5e+08)
C = persalys.Input('C', 2500000000, dist_C, 'Parameter C')
dist_gam = ot.Normal(10, 2)
gam = persalys.Input('gam', 8, dist_gam, 'Parameter gamma')
dist_strain = ot.Uniform(0, 0.07)
strain = persalys.Input('strain', 0, dist_strain, 'Strain')
fakeIn = persalys.Input('fakeIn', 0, '')
sigma = persalys.Output('sigma', 'Stress (Pa)')
fakeSigma = persalys.Output('fakeSigma', 'Stress (Pa)')
inputs = [R, C, gam, strain, fakeIn]
outputs = [sigma, fakeSigma]
formulas = ['R + C * (1 - exp(-gam * strain))', '2*(R + C * (1 - exp(-gam * strain)))']
model1 = persalys.SymbolicPhysicalModel('model1', inputs, outputs, formulas)
myStudy.add(model1)
name='obs1'
physicalModel=model1
inSample = ot.Sample([
