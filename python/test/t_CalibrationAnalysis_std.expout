outSample.setDescription(['sigma'])
obs1 = persalys.Observations(name, physicalModel, inSample, outSample)
myStudy.add(obs1)
myAnalysis = persalys.CalibrationAnalysis('myAnalysis', obs1)
myAnalysis.setMethodName('LeastSquaresLinear')
priorDistribution = ot.Dirac([7e+08, 2.5e+09, 8])
myAnalysis.setCalibratedInputs(['R', 'C', 'gam'], priorDistribution, [], [])
myAnalysis.setConfidenceIntervalLength(0.95)
myStudy.add(myAnalysis)
myAnalysis2 = persalys.CalibrationAnalysis('myAnalysis2', obs1)
myAnalysis2.setMethodName('LeastSquaresNonlinear')
priorDistribution = ot.Dirac([7e+08, 2.4e+09])
myAnalysis2.setCalibratedInputs(['R', 'C'], priorDistribution, ['gam'], [7])
myAnalysis2.setConfidenceIntervalLength(0.95)
myAnalysis2.setBootStrapSize(0)
optimizationAlgo = myAnalysis2.getOptimizationAlgorithm()
optimizationAlgo.setMaximumCallsNumber(1000)
optimizationAlgo.setMaximumAbsoluteError(1e-05)
optimizationAlgo.setMaximumRelativeError(1e-05)
optimizationAlgo.setMaximumResidualError(1e-05)
optimizationAlgo.setMaximumConstraintError(1e-05)
myAnalysis2.setOptimizationAlgorithm(optimizationAlgo)
myStudy.add(myAnalysis2)
myAnalysis3 = persalys.CalibrationAnalysis('myAnalysis3', obs1)
myAnalysis3.setMethodName('GaussianLinear')
R = ot.CorrelationMatrix(3)
priorDistribution = ot.Normal([7e+08, 2.5e+09, 8], [7e+07, 2.5e+08, 0.8], R)
myAnalysis3.setCalibratedInputs(['R', 'C', 'gam'], priorDistribution, [], [])
myAnalysis3.setConfidenceIntervalLength(0.95)
covMatrix = ot.CovarianceMatrix(1)
covMatrix[0, 0] = 1e+14
myAnalysis3.setErrorCovariance(covMatrix)
myStudy.add(myAnalysis3)
myAnalysis4 = persalys.CalibrationAnalysis('myAnalysis4', obs1)
myAnalysis4.setMethodName('GaussianNonlinear')
R = ot.CorrelationMatrix(3)
priorDistribution = ot.Normal([7e+08, 2.5e+09, 8], [7e+07, 2.5e+08, 0.8], R)
myAnalysis4.setCalibratedInputs(['R', 'C', 'gam'], priorDistribution, [], [])
myAnalysis4.setConfidenceIntervalLength(0.99)
covMatrix = ot.CovarianceMatrix(1)
covMatrix[0, 0] = 1e+14
myAnalysis4.setErrorCovariance(covMatrix)
myAnalysis4.setBootStrapSize(50)
optimizationAlgo = myAnalysis4.getOptimizationAlgorithm()
optimizationAlgo.setMaximumCallsNumber(50)
optimizationAlgo.setMaximumAbsoluteError(1e-06)
optimizationAlgo.setMaximumRelativeError(1e-05)
optimizationAlgo.setMaximumResidualError(1e-05)
optimizationAlgo.setMaximumConstraintError(1e-05)
myAnalysis4.setOptimizationAlgorithm(optimizationAlgo)
myStudy.add(myAnalysis4)

