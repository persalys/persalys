class=DataModel name=myDataModel importedDataset= fileName=données.csv inputColumns=[0,2] outputColumns=[] physicalModel=false inputNames=[X0,X2] outputNames=[] type=MC
#!/usr/bin/env python

import openturns as ot
import persalys

myStudy = persalys.Study('myStudy')
A = persalys.Input('A', 0, '')
B = persalys.Input('B', 0, '')
S = persalys.Output('S', '')
inputs = [A, B]
outputs = [S]
formulas = ['A+B+2']
SM = persalys.SymbolicPhysicalModel('SM', inputs, outputs, formulas)
myStudy.add(SM)
inputNames = ['X0', 'X2']
outputNames = []
myDataModelImportedDataset = persalys.ImportedDataset('données.csv', [0,2], [])
myDataModel = persalys.DataModel('myDataModel', myDataModelImportedDataset, inputNames, outputNames)
myDataModel.setType(persalys.DataModel.MC)
myStudy.add(myDataModel)
inputColumns = [0, 2]
doeI = persalys.ImportedDesignOfExperiment('doeI', SM, 'données.csv', inputColumns)
doeI.setBlockSize(1)
interestVariables = ['S']
doeI.setInterestVariables(interestVariables)
doeI.setType(persalys.DataModel.MC)
myStudy.add(doeI)
persalys.Study.Add(myStudy)

#!/usr/bin/env python

import openturns as ot
import persalys

myStudy = persalys.Study('myStudy')
A = persalys.Input('A', 0, '')
B = persalys.Input('B', 0, '')
S = persalys.Output('S', '')
inputs = [A, B]
outputs = [S]
formulas = ['A+B+2']
SM = persalys.SymbolicPhysicalModel('SM', inputs, outputs, formulas)
myStudy.add(SM)
inputNames = ['X0', 'X2']
outputNames = []
myDataModelImportedDataset = persalys.ImportedDataset('données.csv', [0,2], [])
myDataModel = persalys.DataModel('myDataModel', myDataModelImportedDataset, inputNames, outputNames)
myDataModel.setType(persalys.DataModel.MC)
myStudy.add(myDataModel)
inputColumns = [0, 2]
doeI = persalys.ImportedDesignOfExperiment('doeI', SM, 'données.csv', inputColumns)
doeI.setBlockSize(1)
interestVariables = ['S']
doeI.setInterestVariables(interestVariables)
doeI.setType(persalys.DataModel.MC)
myStudy.add(doeI)
persalys.Study.Add(myStudy)

