type=Union, failure events: [Y0 > 20]
type=Union, failure events: [Y0 < 10]
type=Union, failure events: [Y0 < 0]
type=Union, failure events: [Y0 < 15]
type=Union, failure events: [Y1 < 15]
#!/usr/bin/env python

import openturns as ot
import persalys

myStudy = persalys.Study('myStudy')
dist_X0 = ot.Normal(1, 1)
X0 = persalys.Input('X0', 0, dist_X0, '')
dist_X1 = ot.Normal(1, 1)
X1 = persalys.Input('X1', 0, dist_X1, '')
Y0 = persalys.Output('Y0', '')
Y1 = persalys.Output('Y1', '')
inputs = [X0, X1]
outputs = [Y0, Y1]
formulas = ['sin(X0) + 8*X1', '1 + sin(X0) + 8*X1']
aModelPhys = persalys.SymbolicPhysicalModel('aModelPhys', inputs, outputs, formulas)
myStudy.add(aModelPhys)
outputNames = ['Y0']
operators = [ot.Less()]
thresholds = [10]
aLimitState = persalys.LimitState('aLimitState', aModelPhys, outputNames, operators, thresholds, persalys.LimitState.Union)
myStudy.add(aLimitState)
outputNames = ['Y1']
operators = [ot.Less()]
thresholds = [15]
aLimitState2 = persalys.LimitState('aLimitState2', aModelPhys, outputNames, operators, thresholds, persalys.LimitState.Union)
myStudy.add(aLimitState2)
persalys.Study.Add(myStudy)

